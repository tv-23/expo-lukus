---
import "../../public/assets/style/about-us-page.css";
import Navbar from "../components/navbar.astro";
import Layout from "../layouts/Layout.astro";
import PageHeadline from "../components/page-headline.astro";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout>
    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
    ></script>

    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
    ></script>
    <Navbar lang={lang} t={t} />

    <PageHeadline
        title='<h1 class="main-title">ROOTED.<br>GLOBAL.</h1><p class="tagline">Tells the story of the origin (Morocco) and the destination (Global) in one short, massive sentence.</p>'
    />

    <section class="story-section" id="storyPin">
        <div class="sticky-wrapper">
            <div class="container-70">
                <div class="content-flex">
                    <div class="text-column">
                        <!-- CHAPTER 1 -->
                        <div class="story-block" id="block1">
                            <span style="">History // 01</span>
                            <h2>Roots of<br />Expo Lukus.</h2>
                            <p>
                                Expo Lukus is one of the companies founded by
                                the Chetouan family, which has built significant
                                experience in the supply and distribution of
                                fruits and vegetables, along with cold storage
                                services to ensure product quality and safety.
                            </p>
                            <p>
                                Following strong success in this sector, the
                                family expanded its activities by establishing a
                                dedicated export company focused on delivering
                                fresh fruits and vegetables to international
                                markets.
                            </p>

                            <div class="mini-grid">
                                <div class="mini-stat">
                                    <h4>30+</h4><span>Years Experience</span>
                                </div>
                                <div class="mini-stat">
                                    <h4>100%</h4><span>Family Legacy</span>
                                </div>
                            </div>
                        </div>

                        <!-- CHAPTER 2 -->
                        <div class="story-block" id="block2">
                            <span style="">Operations // 02</span>
                            <h2>Integrated<br /> Supply Chain.</h2>
                            <p>
                                Expo Lukus relies on an integrated service chain
                                supported by strong logistical resources
                                developed through years of hands-on experience
                                in the agricultural sector.
                            </p>
                            <p>
                                This allows the company to guarantee
                                high-quality products while maintaining strict
                                compliance with international export standards
                                across all operations.
                            </p>
                            <div class="mini-grid">
                                <div class="mini-stat">
                                    <h4>Global</h4><span>Logistics</span>
                                </div>
                                <div class="mini-stat">
                                    <h4>ISO</h4><span>Standards</span>
                                </div>
                            </div>
                        </div>

                        <!-- CHAPTER 3 -->
                        <div class="story-block" id="block3">
                            <span style="">Commitment // 03</span>
                            <h2>Quality &<br /> Growth.</h2>
                            <p>
                                The company is committed to offering competitive
                                pricing while building long-term, trust-based
                                relationships with its international clients.
                            </p>
                            <p>
                                Beyond profit, Expo Lukus aims to support the
                                development of the agricultural sector and
                                create sustainable economic opportunities for
                                local farmers and partners.
                            </p>
                            <div class="mini-grid">
                                <div class="mini-stat">
                                    <h4>FairPay</h4><span>To Farmers</span>
                                </div>
                                <div class="mini-stat">
                                    <h4>Ethics</h4><span>Driven</span>
                                </div>
                            </div>
                        </div>

                        <!-- CHAPTER 4 -->
                        <div class="story-block" id="block4">
                            <span style="">Vision // 04</span>
                            <h2>Connecting<br /> Markets.</h2>
                            <p>
                                At Expo Lukus, agriculture is seen not only as a
                                business but as a responsibility toward both the
                                land and the people who cultivate it.
                            </p>
                            <p>
                                The company, through Chetouan Import Export in
                                Morocco and Expo Lukus in Spain, builds a strong
                                trade bridge between both countries to
                                facilitate exchange, improve supply chains, and
                                open access to global markets.
                            </p>
                            <div class="mini-grid">
                                <div class="mini-stat">
                                    <h4>Two Hubs</h4><span>Morocco & Spain</span
                                    >
                                </div>
                                <div class="mini-stat">
                                    <h4>Agility</h4><span>Supply Chain</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="portal-column">
                        <div class="portal-frame" id="portal">
                            <div class="portal-img-wrap" id="portalTrack">
                                <img
                                    src="https://images.unsplash.com/photo-1500382017468-9049fed747ef?q=80&w=1200"
                                    alt="Legacy"
                                />
                                <img
                                    src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=1200"
                                    alt="Expansion"
                                />
                                <img
                                    src="https://images.unsplash.com/photo-1610832958506-aa56368176cf?q=80&w=1200"
                                    alt="Farmers"
                                />
                                <img
                                    src="https://images.unsplash.com/photo-1494412519320-aa613dfb7738?q=80&w=1200"
                                    alt="Bridge"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script>
        gsap.registerPlugin(ScrollTrigger);

        // This timeline creates the pinning room and handles the transitions
        let tl = gsap.timeline({
            scrollTrigger: {
                trigger: "#storyPin",
                start: "top top",
                end: "+=350%", // Total scroll distance (3.5 full screens)
                pin: true,
                scrub: 1.5,
                anticipatePin: 1,
            },
        });

        // Initial State fix
        gsap.set("#block1", { opacity: 1, y: 0 });

        // Transition 1: Block 1 out -> Block 2 in
        tl.to("#block1", { opacity: 0, y: -30, duration: 1 })
            .to(
                "#portalTrack",
                { yPercent: -25, ease: "power2.inOut", duration: 2 },
                "s1",
            )
            .to("#block2", { opacity: 1, y: 0, duration: 1 }, "s1+=0.5")

            // Transition 2: Block 2 out -> Block 3 in
            .to("#block2", { opacity: 0, y: -30, duration: 1, delay: 1 })
            .to(
                "#portalTrack",
                { yPercent: -50, ease: "power2.inOut", duration: 2 },
                "s2",
            )
            .to("#block3", { opacity: 1, y: 0, duration: 1 }, "s2+=0.5")

            // Transition 3: Block 3 out -> Block 4 in
            .to("#block3", { opacity: 0, y: -30, duration: 1, delay: 1 })
            .to(
                "#portalTrack",
                { yPercent: -75, ease: "power2.inOut", duration: 2 },
                "s3",
            )
            .to("#block4", { opacity: 1, y: 0, duration: 1 }, "s3+=0.5")

            // Final Buffer (ensures Chapter 4 stays visible briefly before unpinning)
            .to({}, { duration: 1.5 });

        // Parallax Label
        gsap.to(".bg-label", {
            xPercent: -15,
            scrollTrigger: {
                trigger: "#storyPin",
                start: "top bottom",
                end: "bottom top",
                scrub: true,
            },
        });

        // Refresh on load to ensure pinning height is calculated perfectly
        window.addEventListener("load", () => ScrollTrigger.refresh());
    </script>
</Layout>
